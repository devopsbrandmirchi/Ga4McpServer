# Public origin of this app, no trailing slash.
# Local: http://localhost:3000
# Cloud Run: https://ga4-mcp-xxxxxxxxxx-uc.a.run.app
APP_BASE_URL=http://localhost:3000

# Google OAuth web client (MCP server → Google → GA4).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match a redirect URI on the Google OAuth client.
# Defaults to ${APP_BASE_URL}/oauth/google/callback if omitted.
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# Operator setup token. Used to start Google OAuth and to consent
# on /oauth/mcp/authorize when Claude.ai connects.
MCP_AUTH_TOKEN=

# Set after completing Google OAuth.
# Locally written to .env.local. On Cloud Run, set it and a new revision starts.
GOOGLE_REFRESH_TOKEN=

# Optional. Signs OAuth state cookies. Defaults to MCP_AUTH_TOKEN.
OAUTH_STATE_SECRET=

# Optional. Signs MCP access/refresh tokens. Defaults to MCP_AUTH_TOKEN.
MCP_TOKEN_SECRET=

# Optional. Only if you paste a confidential client into Claude.ai
# Custom Connector Advanced Settings.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
